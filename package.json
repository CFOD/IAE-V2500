{
  "name": "v2500-engine-simulator",
  "productName": "V2500 Engine Simulator",
  "version": "0.1.0",
  "description": "Physics-based IAE V2500 turbofan simulator with an interactive 3D cutaway",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "serve": "node tools/serve.js",
    "model": "python3 tools/blender/build_engine.py",
    "dist": "electron-builder",
    "build:web": "node tools/build-web.mjs",
    "build:web:nosound": "node tools/build-web.mjs --no-sounds"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.v2500sim",
    "files": [
      "app/**",
      "src/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    },
    "mac": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "three": "^0.187.0"
  }
}
